{
  "name": "ScopeBlind Repository Connection",
  "url": "https://scopeblind.com",
  "public": true,
  "redirect_url": "https://scopeblind.com/standard",
  "callback_urls": ["https://scopeblind.com/standard"],
  "setup_url": "https://scopeblind.com/standard",
  "setup_on_update": true,
  "request_oauth_on_install": false,
