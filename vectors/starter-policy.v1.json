  "type": "scopeblind.starter-policy-vectors.v1",
  "policy": {
    "spec": "builtin:starter",
    "file": "policies/starter.cedar",
    "version": 1,
    "forbid_rules": 7,
    "policy_digest": "sha256:46d57bf0461dbbeb16299e6eb7fca5fed1bab244aba00d9abaf227681889f9dd",
    "digest_construction": "acta-policy-digest-v1 over one file named policy.cedar, as evaluate --policy computes it for a single file"
  },
  "evaluation": "Each call is evaluated as `protect-mcp evaluate --policy <policy> --tool <tool> --input <input>` evaluates it: principal Agent::\"unknown\", action Action::\"MCP::Tool::call\", resource Tool::\"<tool>\", with the input under context.input and its fields also at the top of context.",
  "semantics": [
    "The starter allows every call except the ones its seven forbid rules match, and a forbid always wins.",
    "Every rule carries @id and @reason; a deny names the matching rule's @id and @reason.",
    "Shell rules match the raw command text with Cedar `like`, so they are best effort: a reworded command can get past them.",
    "Tool input is made Cedar-safe before evaluation: nulls are dropped, a whole number inside Cedar's 64-bit Long stays a number, any other number becomes its JavaScript text (1.5 is \"1.5\"), and __entity, __extn and __expr keys are dropped."
  ],
